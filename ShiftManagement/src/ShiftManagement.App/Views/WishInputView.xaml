<UserControl x:Class="ShiftManagement.App.Views.WishInputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="950">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 上部バー: 職員選択 & アクションボタン -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="対象職員:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                    <ComboBox ItemsSource="{Binding StaffList}" SelectedItem="{Binding SelectedStaff}" DisplayMemberPath="DisplayName" Width="180" Padding="8,4" Margin="0,0,20,0"/>
                    <TextBlock Text="{Binding Year, StringFormat={}{0}年}" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Month, StringFormat={}{0}月}" VerticalAlignment="Center" FontWeight="Bold" Margin="4,0,20,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Content="💾 希望を保存" Command="{Binding SaveWishesCommand}" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="再読込" Command="{Binding LoadCalendarCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- カレンダーグリッド -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding CalendarDays}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Background="#FAFAFA" MinHeight="85">
                                <Grid Margin="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 日付・曜日 -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Day}" FontWeight="Bold" FontSize="15" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding DayOfWeekString}" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSunday}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSaturday}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource PrimaryLightBrush}"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- 現在の希望状態バッジ -->
                                    <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="4" Padding="6,3" Margin="0,4,0,4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E2E8F0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding WishTypeDisplay}" Value="希望休">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding WishTypeDisplay}" Value="勤務不可">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding WishTypeDisplay}" Value="夜勤不可">
                                                        <Setter Property="Background" Value="#FFEDD5"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding WishTypeDisplay}" Value="日勤希望">
                                                        <Setter Property="Background" Value="#E0E7FF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding WishTypeDisplay}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </Border>

                                    <!-- 操作ボタントリガー（コンテキストメニュー用） -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="休" Width="22" Height="20" FontSize="10" Padding="0" Margin="1,0" ToolTip="希望休"
                                                Command="{Binding DataContext.SetDayOffCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="不可" Width="26" Height="20" FontSize="9" Padding="0" Margin="1,0" ToolTip="勤務不可(Hard)"
                                                Command="{Binding DataContext.SetWorkUnavailableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="夜不可" Width="30" Height="20" FontSize="9" Padding="0" Margin="1,0" ToolTip="夜勤不可(Hard)"
                                                Command="{Binding DataContext.SetNightUnavailableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="×" Width="18" Height="20" FontSize="10" Padding="0" Margin="1,0" ToolTip="クリア"
                                                Command="{Binding DataContext.ClearWishCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 下部ステータス -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12,8" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</UserControl>
